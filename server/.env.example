# --- core ---
PORT=3000
DATABASE_URL=postgres://dsr:dsr@127.0.0.1:5432/dsr

# Set to true only once an identity provider is configured. While false,
# password sign-in works for everyone exactly as it always has. When true,
# only super admins and accounts flagged is_break_glass may use a password.
SSO_ENABLED=false

# --- email (spec: Graph-only, environment-owned) ---
# These five keys are read from this file only. A row in app_settings is
# ignored, and the settings API refuses to write one. There is no from-name
# setting: the display name on outgoing mail comes from the shared mailbox's
# own properties in Exchange.
EMAIL_PROVIDER=graph                    # graph | console
PRIVACY_MAILBOX=privacy@company.com

# Azure app registration with Mail.Send application permission, admin
# consented, and an application access policy scoped to PRIVACY_MAILBOX.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Development only. The console adapter refuses to run in production
# unless this is explicitly set.
# ALLOW_CONSOLE_EMAIL=true
